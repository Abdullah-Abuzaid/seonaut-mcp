# Copy to .env and replace every value. Never commit .env.
MYSQL_ROOT_PASSWORD=change-me-root
SEONAUT_DB_PASSWORD=change-me-seonaut
# Password of the read-only database user seonaut-mcp uses.
SEONAUT_MCP_DB_PASSWORD=change-me-read-only
# Signs access tokens. At least 32 characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it invalidates every token.
SEONAUT_MCP_SECRET=
SEONAUT_PUBLIC_URL=https://seonaut.example.com
